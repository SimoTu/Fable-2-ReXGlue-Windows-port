 #include <string_view>
 
 #include <fmt/format.h>
@@ -930,6 +932,23 @@ bool CommandProcessor::ExecutePacketType3_XE_SWAP(memory::RingBuffer* reader, ui
                                                   uint32_t count) {
   SCOPE_profile_cpu_f("gpu");
 
+  // Capture guest swap cadence independently of the optional performance overlay.
+  static auto frame_trace = [] {
+    const char* path = std::getenv("REXGLUE_GUEST_FRAME_TRACE");
+    return path ? std::ofstream(path, std::ios::out | std::ios::noreplace) : std::ofstream();
+  }();
+  if (frame_trace.is_open()) {
+    const auto now = rex::chrono::Clock::QueryHostTickCount();
+    static const auto first = now;
+    static auto previous = now;
+    const auto frequency = rex::chrono::Clock::QueryHostTickFrequency();
+    if (now > previous) {
+      frame_trace << (now - first) * 1000000 / frequency << ','
+                  << (now - previous) * 1000000 / frequency << '\n';
+    }
+    previous = now;
+  }
+
 #ifdef REXGLUE_ENABLE_PERF_COUNTERS
   {
     static uint64_t last_frame_tick = 0;
